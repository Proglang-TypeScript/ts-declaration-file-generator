{
  "name": "ts-declaration-file-generator",
  "version": "1.5.0",
  "description": "Generates a typescript declaration file using runtime analysis information.",
  "bin": {
    "dts-generate": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "node dist/index.js",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "prebuild": "rm -rf dist",
    "build": "node node_modules/typescript/lib/tsc.js",
    "test": "npm run test:clear-cache && jest src/",
    "test:clear-cache": "jest --clearCache",
    "test:e2e": "npm run test:clear-cache && jest e2e/",
    "lint": "eslint --max-warnings 0 'src/**/*.ts'",
    "prettier": "prettier --write 'src/**/*.ts'",
    "script": "ts-node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proglang/ts-declaration-file-generator.git"
  },
  "keywords": [
    "typescript",
    "declaration",
    "files"
  ],
  "author": "fcristiani",
  "license": "MIT",
  "homepage": "https://github.com/proglang/ts-declaration-file-generator",
  "devDependencies": {
    "@types/command-line-args": "5.2.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/object-hash": "3.0.6",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "globals": "17.12.0",
    "@eslint/js": "10.0.1"
  },
  "dependencies": {
    "command-line-args": "6.0.2",
    "object-hash": "3.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
